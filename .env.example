# Отправка заявок на email через Resend (https://resend.com)
RESEND_API_KEY=
# Куда приходят заявки (можно несколько через запятую)
LEAD_EMAIL_TO=
# Отправитель на подтверждённом в Resend домене
LEAD_EMAIL_FROM="WoodCraft <site@example.ge>"

# Адрес сайта — для Open Graph картинок
NEXT_PUBLIC_SITE_URL=https://example.ge

# Пароль для входа в админку /admin.
# В режиме разработки без переменной пароль — admin, в продакшене без неё вход закрыт.
ADMIN_PASSWORD=

# База данных Supabase (Postgres). Интеграция Supabase в Vercel задаёт их сама.
# Без POSTGRES_URL админка работает в демо-режиме: данные в памяти, сбрасываются при перезапуске.
# POSTGRES_URL — через пулер (transaction mode, порт 6543) — для сайта;
# POSTGRES_URL_NON_POOLING — прямое/session-подключение (порт 5432) — для миграций.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Хранилище фото, загружаемых через админку (Vercel Blob, публичный store).
# Новые store подключаются через OIDC: Vercel задаёт BLOB_STORE_ID, а `vercel env pull` —
# временный VERCEL_OIDC_TOKEN (живёт ~12 ч, потом снова env pull). У старых store — BLOB_READ_WRITE_TOKEN.
# Без Blob в демо-режиме фото хранятся в данных как data URL; с базой — загрузка фото недоступна.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Telegram-бот для управления контентом (см. README → «Telegram-бот»).
# Токен от @BotFather. В .env.local — токен отдельного dev-бота, на Vercel — боевого.
TELEGRAM_BOT_TOKEN=
# Секрет webhook: от 16 символов, латиница, цифры, _ и -. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Telegram ID админов через запятую. Свой ID бот покажет, если написать ему без доступа.
TELEGRAM_ADMIN_IDS=
