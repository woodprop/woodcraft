# Отправка заявок на email через Resend (https://resend.com)
RESEND_API_KEY=
# Куда приходят заявки (можно несколько через запятую)
LEAD_EMAIL_TO=
# Отправитель на подтверждённом в Resend домене
LEAD_EMAIL_FROM="WoodCraft <site@example.ge>"

# Адрес сайта — для Open Graph картинок
NEXT_PUBLIC_SITE_URL=https://example.ge

# Пароль для входа в админку /admin.
# В режиме разработки без переменной пароль — admin, в продакшене без неё вход закрыт.
ADMIN_PASSWORD=
